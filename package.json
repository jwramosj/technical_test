{
  "name": "moleculer-realworld-example-app",
  "version": "1.0.0",
  "description": "RealWorld example app with Moleculer microservices framework",
  "scripts": {
    "dev": "moleculer-runner --repl --hot services",
    "start": "moleculer-runner services",
    "ci": "jest --watch",
    "test": "jest --coverage",
    "lint": "eslint services",
    "docker:build": "docker build -t conduit ."
  },
  "keywords": [
    "microservices",
    "moleculer",
    "realworld"
  ],
  "author": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "jest-cli": "^30.5.1",
    "moleculer-repl": "^0.8.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "moleculer": "^0.15.2",
    "moleculer-db": "^0.9.0",
    "moleculer-db-adapter-mongo": "^0.5.0",
    "moleculer-web": "^0.11.0",
    "nats": "^2.29.3",
    "slug": "^12.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ice-services/moleculer-realworld-example-app.git"
  },
  "engines": {
    "node": ">= 20"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "./services",
    "roots": [
      "../test"
    ]
  }
}
